#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Push constants – only camera data now
layout(push_constant) uniform PushConstants {
    vec4 camPos_time;   // xyz = camera position, w = time (s)
    mat4 viewMatrix;
    vec4 aspect;        // x = aspect ratio (width/height)
} pc;

// Shared physics state written by physics_step.comp
struct Body {
    vec4 posRad;
    vec4 velMas;
    vec4 quat;    // orientation quaternion
    vec4 angVel;  // xyz ω, w unused
};

layout(std430, binding = 0) readonly buffer StateBuffer {
    Body bodies[];
};

layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// -------------------------------------------------------------
float mandelbulbSDF(vec3 p) {
    // Translate into bulb-local space
    p -= bodies[1].posRad.xyz;

    // Apply bulb quaternion rotation
    vec4 q = bodies[1].quat;
    mat3 rot = mat3(
        1.0 - 2.0*(q.y*q.y + q.z*q.z), 2.0*(q.x*q.y - q.z*q.w),     2.0*(q.x*q.z + q.y*q.w),
        2.0*(q.x*q.y + q.z*q.w),     1.0 - 2.0*(q.x*q.x + q.z*q.z), 2.0*(q.y*q.z - q.x*q.w),
        2.0*(q.x*q.z - q.y*q.w),     2.0*(q.y*q.z + q.x*q.w),     1.0 - 2.0*(q.x*q.x + q.y*q.y)
    );
    p = rot * p;

    vec3 z = p;
    float dr = 1.0;
    float r  = 0.0;
    for(int i=0;i<15;++i){
        r = length(z);
        if(r>2.0) break;
        float theta = acos(z.z/r);
        float phi   = atan(z.y,z.x);
        float zr = pow(r,8.0);
        theta *= 8.0;
        phi   *= 8.0;
        z = zr*vec3(sin(theta)*cos(phi), sin(theta)*sin(phi), cos(theta));
        z += p;
        dr = pow(r,7.0)*8.0*dr + 1.0;
    }
    return 0.5*log(r)*r/dr;
}

vec3 estimateNormal(vec3 p){
    const float eps = 0.001;
    return normalize(vec3(
        mandelbulbSDF(vec3(p.x+eps,p.y,p.z)) - mandelbulbSDF(vec3(p.x-eps,p.y,p.z)),
        mandelbulbSDF(vec3(p.x,p.y+eps,p.z)) - mandelbulbSDF(vec3(p.x,p.y-eps,p.z)),
        mandelbulbSDF(vec3(p.x,p.y,p.z+eps)) - mandelbulbSDF(vec3(p.x,p.y,p.z-eps))
    ));
}

vec3 raymarch(vec3 ro, vec3 rd){
    const float maxDist = 100.0;
    float distAccum = 0.0;
    vec3 pos = ro;
    for(int i=0;i<100;++i){
        float bulbDist   = mandelbulbSDF(pos);
        float marbleDist = length(pos - bodies[0].posRad.xyz) - bodies[0].posRad.w;
        float sceneDist  = min(bulbDist, marbleDist);
        if(sceneDist < 0.001){
            bool hitMarble = marbleDist < bulbDist;
            vec3 normal = hitMarble ? normalize(pos - bodies[0].posRad.xyz)
                                     : estimateNormal(pos);
            vec3 lightDir = normalize(vec3(1.0,1.0,1.0));
            float diffuse = max(dot(normal, lightDir), 0.0);
            float ambient = 0.3;
            vec3 baseColor = hitMarble ? vec3(0.8,0.2,0.2) : vec3(0.2,0.6,0.8);
            return baseColor*(diffuse+ambient);
        }
        if(distAccum>maxDist) break;
        distAccum += sceneDist;
        pos = ro + rd*distAccum;
    }
    return vec3(0.1,0.2,0.4);
}

void main(){
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(outputImage);
    if(pixel.x>=size.x || pixel.y>=size.y) return;

    vec2 uv = (vec2(pixel)+0.5)/vec2(size);
    uv = uv*2.0 - 1.0;
    uv.x *= pc.aspect.x;

    vec3 ro = pc.camPos_time.xyz;
    vec3 rd = normalize(vec3(uv,1.0));
    rd = normalize((pc.viewMatrix*vec4(rd,0.0)).xyz);

    vec3 col = raymarch(ro, rd);
    imageStore(outputImage, pixel, vec4(col,1.0));
}
