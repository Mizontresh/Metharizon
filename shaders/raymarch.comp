#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    vec3 cameraPos;
    float time;
    mat4 viewMatrix;
    float aspectRatio;
} pc;

layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// Mandelbulb distance field
float mandelbulbSDF(vec3 p) {
    vec3 z = p;
    float dr = 1.0;
    float r = 0.0;
    
    for (int i = 0; i < 15; i++) {
        r = length(z);
        if (r > 2.0) break;
        
        // Convert to polar coordinates
        float theta = acos(z.z / r);
        float phi = atan(z.y, z.x);
        
        // Power-8 Mandelbulb
        float zr = pow(r, 8.0);
        theta = theta * 8.0;
        phi = phi * 8.0;
        
        // Convert back to cartesian coordinates
        z = zr * vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
        z += p;
        
        dr = pow(r, 7.0) * 8.0 * dr + 1.0;
    }
    
    return 0.5 * log(r) * r / dr;
}

vec3 estimateNormal(vec3 p) {
    const float epsilon = 0.001;
    return normalize(vec3(
        mandelbulbSDF(vec3(p.x + epsilon, p.y, p.z)) - mandelbulbSDF(vec3(p.x - epsilon, p.y, p.z)),
        mandelbulbSDF(vec3(p.x, p.y + epsilon, p.z)) - mandelbulbSDF(vec3(p.x, p.y - epsilon, p.z)),
        mandelbulbSDF(vec3(p.x, p.y, p.z + epsilon)) - mandelbulbSDF(vec3(p.x, p.y, p.z - epsilon))
    ));
}

vec3 raymarch(vec3 ro, vec3 rd) {
    float maxDist = 100.0;
    float dist = 0.0;
    vec3 pos = ro;
    
    for (int i = 0; i < 100; i++) {
        float sceneDist = mandelbulbSDF(pos);
        if (sceneDist < 0.001) {
            vec3 normal = estimateNormal(pos);
            
            // Lighting
            vec3 lightDir = normalize(vec3(1.0, 1.0, 1.0));
            float diffuse = max(dot(normal, lightDir), 0.0);
            float ambient = 0.3;
            
            // Color based on position
            vec3 color = vec3(0.2, 0.6, 0.8);
            color *= (diffuse + ambient);
            
            return color;
        }
        if (dist > maxDist) break;
        dist += sceneDist;
        pos = ro + rd * dist;
    }
    
    // Background gradient
    return vec3(0.1, 0.2, 0.4);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);
    
    // Check if we're within the image bounds
    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }
    
    // Create ray from camera
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(imageSize);
    uv = uv * 2.0 - 1.0;
    uv.x *= pc.aspectRatio;
    
    // Camera setup
    vec3 ro = pc.cameraPos;
    vec3 rd = normalize(vec3(uv, 1.0));
    
    // Apply view matrix to ray direction
    rd = normalize((pc.viewMatrix * vec4(rd, 0.0)).xyz);
    
    vec3 color = raymarch(ro, rd);
    
    // Write to output image
    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
} 