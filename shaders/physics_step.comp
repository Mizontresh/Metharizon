#version 450

// One invocation per marble. For now we assume exactly *one* marble and
// therefore dispatch 1×1×1 work-groups.  The code is written so we can
// scale to many marbles later (index = gl_GlobalInvocationID.x).
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// ---------- Scene-wide constants ------------------------------
// These are the same physical constants we used on the CPU side.  They
// could also come from a UBO, but push-constants are simplest.
layout(push_constant) uniform PC {
    float dt;            // simulation time step (seconds)
    float bigG;          // gravitational constant (our tuned value)
    float restitution;   // bounciness 0 … 1
} pc;

// ---------- Shared state buffer --------------------------------
// std430 so vec4 elements are tightly packed (aligned to 16 B).
//
// Index 0    – marble
// Index 1    – mandelbulb (treated as rigid sphere for translation)
//            – its rotation is handled by the bulbAngle push constant.
struct Body {
    vec4 posRad;   // xyz position, w = radius (m)
    vec4 velMas;   // xyz linear velocity, w = mass (kg)
    vec4 quat;     // orientation quaternion (xyz, w)
    vec4 angVel;   // xyz angular velocity (rad/s), w unused
};

layout(std430, binding = 0) buffer StateBuffer {
    Body bodies[];
} state;

#define MARBLE 0
#define BULB   1

// ---------------------------------------------------------------
// Mandelbulb SDF – identical to the renderer (except we translate by
// bulb position first and *then* rotate by bulbAngle).
float mandelbulbSDF(vec3 p) {
    // Translate into bulb space
    p -= state.bodies[BULB].posRad.xyz;

    // Rotate around Y axis
    vec4 qb = state.bodies[BULB].quat;
    // conjugate for inverse rotation
    vec4 qc = vec4(-qb.xyz, qb.w);
    mat3 rot = mat3(
        1.0 - 2.0*(qc.y*qc.y + qc.z*qc.z), 2.0*(qc.x*qc.y - qc.z*qc.w),     2.0*(qc.x*qc.z + qc.y*qc.w),
        2.0*(qc.x*qc.y + qc.z*qc.w),     1.0 - 2.0*(qc.x*qc.x + qc.z*qc.z), 2.0*(qc.y*qc.z - qc.x*qc.w),
        2.0*(qc.x*qc.z - qc.y*qc.w),     2.0*(qc.y*qc.z + qc.x*qc.w),     1.0 - 2.0*(qc.x*qc.x + qc.y*qc.y)
    );
    p = rot * p;

    vec3 z = p;
    float dr = 1.0;
    float r  = 0.0;

    for (int i = 0; i < 32; ++i) {
        r = length(z);
        if (r > 2.0) break;
        // spherical → polar
        float theta = acos(z.z / r);
        float phi   = atan(z.y, z.x);
        // power 8
        float zr = pow(r, 8.0);
        theta *= 8.0; phi *= 8.0;
        // back to cartesian
        z = zr * vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
        z += p;
        dr = pow(r, 7.0) * 8.0 * dr + 1.0;
    }
    return 0.5 * log(r) * r / dr;
}

vec3 estimateNormal(vec3 p) {
    const float eps = 0.0001;
    return normalize(vec3(
        mandelbulbSDF(vec3(p.x + eps, p.y, p.z)) - mandelbulbSDF(vec3(p.x - eps, p.y, p.z)),
        mandelbulbSDF(vec3(p.x, p.y + eps, p.z)) - mandelbulbSDF(vec3(p.x, p.y - eps, p.z)),
        mandelbulbSDF(vec3(p.x, p.y, p.z + eps)) - mandelbulbSDF(vec3(p.x, p.y, p.z - eps))
    ));
}

// ---------------------------------------------------------------
void main() {
    uint idx = gl_GlobalInvocationID.x;      // marble index
    if (idx >= 1) return;                    // only one marble for now

    Body marble = state.bodies[MARBLE];
    Body bulb   = state.bodies[BULB];

    const int SUB_STEPS = 4;
    for (int step = 0; step < SUB_STEPS; ++step) {
        float subDt = pc.dt / float(SUB_STEPS);

        // ---------------- Gravity ----------------------------------
    vec3 r     = bulb.posRad.xyz - marble.posRad.xyz;
    float dist = length(r);
    vec3 dir   = (dist > 0.0) ? r / dist : vec3(0.0);

    float F = pc.bigG * marble.velMas.w * bulb.velMas.w / (dist*dist + 1e-6);
    vec3 accelMarble =  F / marble.velMas.w * dir;
    vec3 accelBulb   = -F / bulb.velMas.w   * dir;

    // ---------------- Integrate (semi-implicit Euler) ----------
    marble.velMas.xyz += accelMarble * subDt;
    bulb.velMas.xyz   += accelBulb   * subDt;

    marble.posRad.xyz += marble.velMas.xyz * subDt;
    bulb.posRad.xyz   += bulb.velMas.xyz   * subDt;

    // ---- Integrate quaternion orientation ----
    vec3 omega1 = marble.angVel.xyz;
    vec4 q1 = marble.quat;
    vec4 dq1 = 0.5 * vec4(cross(q1.xyz, omega1) + q1.w * omega1, -dot(q1.xyz, omega1));
    q1 += dq1 * subDt;
    q1 = normalize(q1);
    marble.quat = q1;

    vec3 omega2 = bulb.angVel.xyz;
    vec4 q2 = bulb.quat;
    vec4 dq2 = 0.5 * vec4(cross(q2.xyz, omega2) + q2.w * omega2, -dot(q2.xyz, omega2));
    q2 += dq2 * subDt;
    q2 = normalize(q2);
    bulb.quat = q2;

    // ---------------- Collision against Mandelbulb -------------
    float d = mandelbulbSDF(marble.posRad.xyz) - marble.posRad.w;
    if (d < 0.0) {
        // Penetration → project out & apply impulse
        vec3 n = estimateNormal(marble.posRad.xyz);
        marble.posRad.xyz -= n * d;   // push out exactly to the surface

        // Contact vector (from bulb to marble)
        vec3 rA = marble.posRad.xyz - bulb.posRad.xyz;

        // Relative velocity at contact including rotation
        vec3 velA = marble.velMas.xyz + cross(marble.angVel.xyz, rA);
        vec3 velB = bulb.velMas.xyz   - cross(bulb.angVel.xyz,   rA);
        float relVelN = dot(velA - velB, n);

        if (relVelN < 0.0) {
            float m1 = marble.velMas.w;
            float m2 = bulb.velMas.w;
            float r1 = marble.posRad.w;
            float r2 = bulb.posRad.w;

            float invI1 = 5.0 / (2.0 * m1 * r1 * r1);
            float invI2 = 5.0 / (2.0 * m2 * r2 * r2);

            float denom = (1.0 / m1 + 1.0 / m2)
                        + dot(n, cross(invI1 * cross(rA, n), rA) + cross(invI2 * cross(rA, n), rA));

            float j = -(1.0 + pc.restitution) * relVelN / denom;
            vec3 impulse = j * n;

            // Linear velocity update
            marble.velMas.xyz += impulse / m1;
            bulb.velMas.xyz   -= impulse / m2;

            // Angular velocity update
            marble.angVel.xyz += invI1 * cross(rA, impulse);
            bulb.angVel.xyz   -= invI2 * cross(rA, impulse);
        }
    }

    } // end for SUB_STEPS

    // ---------------- End sub-step loop -----------------------

    // ---------------- Write back to the SSBO -------------------
    state.bodies[MARBLE] = marble;
    state.bodies[BULB]   = bulb;
}
